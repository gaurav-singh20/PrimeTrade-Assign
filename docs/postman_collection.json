{
    "info": {
        "_postman_id": "7f3e6a24-3d56-4f8b-b8b8-9c497ebd0f42",
        "name": "PrimeTrade MERN Backend API",
        "description": "Postman collection for authentication, task management, and admin endpoints.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "AUTH",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123\"\n}"
                        },
                        "url": "{{base_url}}/auth/register"
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass123\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": "{{base_url}}/auth/refresh"
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": "{{base_url}}/auth/logout"
                    }
                }
            ]
        },
        {
            "name": "TASKS",
            "item": [
                {
                    "name": "Create Task",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Complete assignment\",\n  \"description\": \"Finish MERN backend task\",\n  \"status\": \"todo\"\n}"
                        },
                        "url": "{{base_url}}/tasks"
                    }
                },
                {
                    "name": "Get Tasks",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": "{{base_url}}/tasks?page=1&limit=10&status=todo&sort=-createdAt"
                    }
                },
                {
                    "name": "Get Task By ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": "{{base_url}}/tasks/{{taskId}}"
                    }
                },
                {
                    "name": "Update Task",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Complete assignment (updated)\",\n  \"description\": \"Finish MERN backend task with docs\",\n  \"status\": \"in_progress\"\n}"
                        },
                        "url": "{{base_url}}/tasks/{{taskId}}"
                    }
                },
                {
                    "name": "Delete Task",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": "{{base_url}}/tasks/{{taskId}}"
                    }
                }
            ]
        },
        {
            "name": "ADMIN",
            "item": [
                {
                    "name": "Get Users (Admin)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": "{{base_url}}/admin/users"
                    }
                },
                {
                    "name": "Update User Role (Admin)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"admin\"\n}"
                        },
                        "url": "{{base_url}}/admin/users/{{userId}}/role"
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5001/api/v1"
        },
        {
            "key": "access_token",
            "value": ""
        },
        {
            "key": "taskId",
            "value": "replace_with_task_id"
        },
        {
            "key": "userId",
            "value": "replace_with_user_id"
        }
    ]
}